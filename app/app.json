{
	"expo": {
		"name": "Vitals",
		"slug": "vitals",
		"version": "1.0.0",
		"orientation": "portrait",
		"icon": "./assets/images/icon.png",
		"scheme": "vitals",
		"userInterfaceStyle": "automatic",
		"newArchEnabled": true,
		"splash": {
			"image": "./assets/images/splash-icon.png",
			"resizeMode": "contain",
			"backgroundColor": "#ffffff"
		},
		"ios": {
			"supportsTablet": true,
			"bundleIdentifier": "com.stefan.vitals",
			"infoPlist": {
				"ITSAppUsesNonExemptEncryption": false,
				"NSLocalNetworkUsageDescription": "Allow Vitals to connect to the Vitals server on your local network.",
				"NSAppTransportSecurity": {
					"NSAllowsLocalNetworking": true
				}
			}
		},
		"android": {
			"adaptiveIcon": {
				"foregroundImage": "./assets/images/adaptive-icon.png",
				"backgroundColor": "#ffffff"
			},
			"edgeToEdgeEnabled": true,
			"predictiveBackGestureEnabled": false,
			"permissions": [
				"android.permission.RECORD_AUDIO",
				"android.permission.MODIFY_AUDIO_SETTINGS",
				"android.permission.CAMERA",
				"android.permission.ACCESS_COARSE_LOCATION",
				"android.permission.ACCESS_FINE_LOCATION"
			]
		},
		"web": {
			"bundler": "metro",
			"output": "static",
			"favicon": "./assets/images/favicon.png"
		},
		"plugins": [
			"expo-router",
			[
				"expo-audio",
				{
					"microphonePermission": "Allow Vitals to record diary audio."
				}
			],
			[
				"expo-camera",
				{
					"cameraPermission": "Allow Vitals to record video logs.",
					"microphonePermission": "Allow Vitals to record video log audio."
				}
			],
			[
				"expo-location",
				{
					"locationWhenInUsePermission": "Allow Vitals to attach your current location to diary entries."
				}
			],
			[
				"expo-image-picker",
				{
					"cameraPermission": "Allow Vitals to take pill label photos.",
					"photosPermission": "Allow Vitals to add pill label photos."
				}
			],
			"expo-video"
		],
		"experiments": {
			"typedRoutes": true
		},
		"extra": {
			"router": {},
			"eas": {
				"projectId": "f99c1f75-dfe5-4428-9dc0-65043f42105e"
			}
		},
		"owner": "stefanmirea"
	}
}
